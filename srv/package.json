{
  "name": "laser-saber-customiser-server",
  "description": "",
  "version": "1.0.0",
  "author": "XcinnaY",
  "maintainer": "XcinnaY",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "bin": "./dist/src/server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yannickbattail/laser-saber-customiser"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm ./*.js ./*/*.js || true",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node ./server.js",
    "test": "vitest run --coverage ./tests/",
    "lint": "eslint --fix .",
    "format": "prettier --log-level error --write .",
    "depcheck": "depcheck --quiet --ignore-path=./.gitignore --ignores='@types/*,@vitest/coverage-v8,stylelint'",
    "check": "npm run depcheck && npm run format && npm run lint && npm run build && npm run test",
    "check-updates": "npm-check-updates -u && npm update --save && npm i && npm dedupe && npm run check"
  },
  "dependencies": {
    "@types/node": "^26.0.1",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "openscad-cli-wrapper": "^1.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
