{
  "name": "laser-saber-customiser",
  "scripts": {
    "build:watch": "./start_dev.sh",
    "start": "npm run -w srv start",
    "publish-new-v": "npm version patch --no-git-tag-version && npm run --ws check:all && npm publish",
    "clean:all": "npm run --ws clean",
    "test:all": "npm run --ws test",
    "lint:all": "npm run --ws lint",
    "format:all": "npm run --ws format",
    "depcheck:all": "npm run --ws depcheck",
    "check:all": "npm run --ws check",
    "check-updates": "npm run --ws check-updates"
  },
  "workspaces": [
    "src",
    "srv"
  ]
}
