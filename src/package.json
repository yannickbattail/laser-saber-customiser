{
  "name": "laser-saber-customiser-web",
  "description": "",
  "version": "1.0.5",
  "author": "XcinnaY",
  "maintainer": "XcinnaY",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "main": "dist/src/Gui.js",
  "types": "dist/src/Gui.d.ts",
  "bin": "./dist/src/Gui.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yannickbattail/laser-saber-customiser"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm ./dist/* ../srv/gen/* || true",
    "clean_gen": "rm ../srv/gen/*",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run --coverage ./tests/",
    "lint": "eslint --fix .",
    "format": "stylelint ./*.css && prettier --log-level error --write .",
    "depcheck": "depcheck --quiet --ignore-path=./.gitignore --ignores='@types/*,@vitest/coverage-v8,lie,pako,readable-stream,setimmediate,immediate'",
    "check": "npm run depcheck && npm run format && npm run lint && npm run build && npm run test",
    "check-updates": "npx npm-check-updates -u --reject typescript && npm update --save && npm i && npm dedupe && npm run check",
    "publish-new-v": "npm version patch --no-git-tag-version && npm run check && npm publish"
  },
  "dependencies": {
    "openscad-cli-wrapper": "^1.5.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.4",
    "depcheck": "^1.4.7",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
